rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    function isSignedIn() {
      return request.auth != null;
    }

    function isOwner(userId) {
      return isSignedIn() && request.auth.uid == userId;
    }

    function isHistoricalAdmin(userId) {
      return isOwner(userId)
        && request.auth.token.email == 'diegorp.1978@gmail.com'
        && request.auth.token.email_verified == true;
    }

    function isValidFinancialPerformanceMonthKey(monthKey) {
      return monthKey is string
        && monthKey.matches('^([0-9]{3}[1-9]|[0-9]{2}[1-9][0-9]|[0-9][1-9][0-9]{2}|[1-9][0-9]{3})-(0[1-9]|1[0-2])$');
    }

    function isNextFinancialPerformanceMonth(startMonth, endMonth) {
      let startParts = startMonth.split('-');
      let endParts = endMonth.split('-');
      let startYear = int(startParts[0]);
      let startNumber = int(startParts[1]);
      let endYear = int(endParts[0]);
      let endNumber = int(endParts[1]);
      return (startYear == endYear && endNumber == startNumber + 1)
        || (startNumber == 12 && endYear == startYear + 1 && endNumber == 1);
    }

    function hasValidFinancialPerformancePeriod(data, monthKey) {
      return isValidFinancialPerformanceMonthKey(monthKey)
        && (
          data.keys().hasAll(['startMonth', 'endMonth'])
          && isValidFinancialPerformanceMonthKey(data.startMonth)
          && isValidFinancialPerformanceMonthKey(data.endMonth)
          && data.endMonth == monthKey
          && isNextFinancialPerformanceMonth(data.startMonth, data.endMonth)
          || !data.keys().hasAny(['startMonth', 'endMonth'])
          && monthKey == '2026-08'
        );
    }

    function financialPerformancePeriodsMatch(headData, revisionData, monthKey) {
      return hasValidFinancialPerformancePeriod(headData, monthKey)
        && hasValidFinancialPerformancePeriod(revisionData, monthKey)
        && (
          headData.keys().hasAll(['startMonth', 'endMonth'])
          && revisionData.keys().hasAll(['startMonth', 'endMonth'])
          && headData.startMonth == revisionData.startMonth
          && headData.endMonth == revisionData.endMonth
          || !headData.keys().hasAny(['startMonth', 'endMonth'])
          && !revisionData.keys().hasAny(['startMonth', 'endMonth'])
          && monthKey == '2026-08'
        );
    }

    function hasValidFinancialPerformancePerimeter(data, perimeter) {
      return (perimeter == 'investment'
          && (!data.keys().hasAny(['perimeter']) || data.perimeter == perimeter))
        || (perimeter == 'investment_with_risk'
          && data.keys().hasAll(['perimeter', 'startMonth', 'endMonth'])
          && data.perimeter == perimeter);
    }

    function pointsToFinancialPerformanceRevisionAfter(database, userId, monthKey, headData, perimeter) {
      let revisionId = headData.currentRevisionId;
      let revisionPath = perimeter == 'investment'
        ? /databases/$(database)/documents/aurum_financial_performance/$(userId)/months/$(monthKey)/revisions/$(revisionId)
        : /databases/$(database)/documents/aurum_financial_performance/$(userId)/perimeters/$(perimeter)/months/$(monthKey)/revisions/$(revisionId);
      return existsAfter(revisionPath)
        && hasValidFinancialPerformancePerimeter(getAfter(revisionPath).data, perimeter)
        && getAfter(revisionPath).data.schemaVersion == 1
        && getAfter(revisionPath).data.monthKey == monthKey
        && financialPerformancePeriodsMatch(headData, getAfter(revisionPath).data, monthKey)
        && getAfter(revisionPath).data.revision == headData.currentRevision
        && getAfter(revisionPath).data.revisionId == revisionId
        && getAfter(revisionPath).data.createdByUid == userId
        && getAfter(revisionPath).data.createdAt == request.time;
    }

    function pointsToFinancialPerformanceHeadAfter(database, userId, monthKey, revisionData, revisionId, perimeter) {
      let headPath = perimeter == 'investment'
        ? /databases/$(database)/documents/aurum_financial_performance/$(userId)/months/$(monthKey)
        : /databases/$(database)/documents/aurum_financial_performance/$(userId)/perimeters/$(perimeter)/months/$(monthKey);
      return existsAfter(headPath)
        && hasValidFinancialPerformancePerimeter(getAfter(headPath).data, perimeter)
        && getAfter(headPath).data.currentRevision == revisionData.revision
        && getAfter(headPath).data.currentRevisionId == revisionId
        && financialPerformancePeriodsMatch(getAfter(headPath).data, revisionData, monthKey)
        && getAfter(headPath).data.updatedAt == request.time;
    }

    function isValidFinancialPerformanceMonthPointer(database, userId, monthKey, perimeter) {
      let data = request.resource.data;
      return isOwner(userId)
        && hasValidFinancialPerformancePeriod(data, monthKey)
        && hasValidFinancialPerformancePerimeter(data, perimeter)
        && data.keys().hasOnly(['schemaVersion', 'monthKey', 'perimeter', 'startMonth', 'endMonth', 'currentRevision', 'currentRevisionId', 'updatedAt'])
        && data.keys().hasAll(['schemaVersion', 'monthKey', 'currentRevision', 'currentRevisionId', 'updatedAt'])
        && data.schemaVersion == 1
        && data.monthKey == monthKey
        && data.currentRevision is int
        && data.currentRevision > 0
        && data.currentRevisionId is string
        && data.currentRevisionId == string(data.currentRevision)
        && data.updatedAt == request.time
        && pointsToFinancialPerformanceRevisionAfter(database, userId, monthKey, data, perimeter);
    }

    function isValidFinancialPerformanceRevision(database, userId, monthKey, revisionId, perimeter) {
      let data = request.resource.data;
      return isOwner(userId)
        && hasValidFinancialPerformancePeriod(data, monthKey)
        && hasValidFinancialPerformancePerimeter(data, perimeter)
        && revisionId.matches('^[1-9][0-9]*$')
        && data.keys().hasOnly([
          'schemaVersion', 'monthKey', 'perimeter', 'startMonth', 'endMonth', 'revision', 'revisionId', 'flowCompleteness',
          'positionMovementCompleteness', 'flows', 'createdAt', 'createdByUid'
        ])
        && data.keys().hasAll([
          'schemaVersion', 'monthKey', 'revision', 'revisionId', 'flowCompleteness',
          'positionMovementCompleteness', 'flows', 'createdAt', 'createdByUid'
        ])
        && data.schemaVersion == 1
        && data.monthKey == monthKey
        && data.revision is int
        && data.revision > 0
        && data.revisionId == revisionId
        && revisionId == string(data.revision)
        && data.flowCompleteness in ['complete', 'incomplete']
        && data.positionMovementCompleteness in ['no_unrecorded_movements', 'unconfirmed']
        && data.flows is list
        && data.flows.size() <= 100
        && data.createdAt == request.time
        && data.createdByUid == userId
        // Flow-item fields are validated by the app service; Rules enforce the owner-scoped envelope and list size.
        && pointsToFinancialPerformanceHeadAfter(database, userId, monthKey, data, revisionId, perimeter);
    }

    // Aurum wealth data is user-scoped. This includes:
    // - root wealth doc
    // - monthly close checkpoints
    // - backups
    // - undo audit
    match /aurum_wealth/{userId} {
      allow read, create, update, delete: if isOwner(userId);

      match /{subPath=**} {
        allow read, create, update, delete: if isOwner(userId);
      }
    }

    // Performance confirmations are stored separately from certified wealth closures.
    // Each revision is append-only; only the month document's current pointer can change.
    match /aurum_financial_performance/{userId}/months/{monthKey} {
      allow read: if isOwner(userId) && isValidFinancialPerformanceMonthKey(monthKey);
      allow create: if isValidFinancialPerformanceMonthPointer(database, userId, monthKey, 'investment')
        && request.resource.data.currentRevision == 1;
      allow update: if isValidFinancialPerformanceMonthPointer(database, userId, monthKey, 'investment')
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly([
          'perimeter', 'startMonth', 'endMonth', 'currentRevision', 'currentRevisionId', 'updatedAt'
        ])
        && (!resource.data.keys().hasAny(['startMonth', 'endMonth'])
          || (request.resource.data.startMonth == resource.data.startMonth
            && request.resource.data.endMonth == resource.data.endMonth))
        && (!resource.data.keys().hasAny(['perimeter'])
          || request.resource.data.perimeter == resource.data.perimeter)
        && request.resource.data.currentRevision == resource.data.currentRevision + 1;
      allow delete: if false;

      match /revisions/{revisionId} {
        allow read: if isOwner(userId) && isValidFinancialPerformanceMonthKey(monthKey);
        allow create: if isValidFinancialPerformanceRevision(database, userId, monthKey, revisionId, 'investment');
        allow update, delete: if false;
      }
    }

    // Risk-inclusive confirmations have their own immutable revision stream.
    match /aurum_financial_performance/{userId}/perimeters/{perimeter}/months/{monthKey} {
      allow read: if perimeter == 'investment_with_risk' && isOwner(userId) && isValidFinancialPerformanceMonthKey(monthKey);
      allow create: if perimeter == 'investment_with_risk' && isValidFinancialPerformanceMonthPointer(database, userId, monthKey, perimeter)
        && request.resource.data.currentRevision == 1;
      allow update: if perimeter == 'investment_with_risk' && isValidFinancialPerformanceMonthPointer(database, userId, monthKey, perimeter)
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly([
          'perimeter', 'startMonth', 'endMonth', 'currentRevision', 'currentRevisionId', 'updatedAt'
        ])
        && (!resource.data.keys().hasAny(['startMonth', 'endMonth'])
          || (request.resource.data.startMonth == resource.data.startMonth
            && request.resource.data.endMonth == resource.data.endMonth))
        && (!resource.data.keys().hasAny(['perimeter'])
          || request.resource.data.perimeter == resource.data.perimeter)
        && request.resource.data.currentRevision == resource.data.currentRevision + 1;
      allow delete: if false;

      match /revisions/{revisionId} {
        allow read: if perimeter == 'investment_with_risk' && isOwner(userId) && isValidFinancialPerformanceMonthKey(monthKey);
        allow create: if perimeter == 'investment_with_risk' && isValidFinancialPerformanceRevision(database, userId, monthKey, revisionId, perimeter);
        allow update, delete: if false;
      }
    }

    // Historical correction artifacts are written only by Firebase Admin.
    // The authorized owner may read them for download/rollback previews.
    match /aurum_historical_backups/{userId}/{document=**} {
      allow read: if isHistoricalAdmin(userId);
      allow create, update, delete: if false;
    }

    match /aurum_historical_checkpoints/{userId}/{document=**} {
      allow read: if isHistoricalAdmin(userId);
      allow create, update, delete: if false;
    }

    match /aurum_historical_audits/{userId}/{document=**} {
      allow read: if isHistoricalAdmin(userId);
      allow create, update, delete: if false;
    }

    // User-scoped MIDAS config persisted in the same Firebase project.
    match /users/{userId} {
      allow read, create, update, delete: if isOwner(userId);

      match /{subPath=**} {
        allow read, create, update, delete: if isOwner(userId);
      }
    }

    // Published Aurum snapshot is read by authenticated clients.
    // Writes are performed by server/admin code only.
    match /aurum_published/{docId} {
      allow read: if isSignedIn();
      allow create, update, delete: if false;
    }

    // Legacy global MIDAS config can still be inspected by authenticated clients,
    // but should not be written directly from the browser.
    match /midas_config/{docId} {
      allow read: if isSignedIn();
      allow create, update, delete: if false;
    }

    // Refresh intents are managed by server/admin code.
    match /fintoc_refresh_intents/{docId} {
      allow read, create, update, delete: if false;
    }

    match /{document=**} {
      allow read, create, update, delete: if false;
    }
  }
}
